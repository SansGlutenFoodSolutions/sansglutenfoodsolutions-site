<!-- SGFS_FRANCE_FLAG_PATCH_JS -->
<script>
(function() {
  function patchFranceBlock() {
    var nodes = Array.from(document.querySelectorAll('h1,h2,h3,h4,h5,h6,p,span,strong,div'));
    var label = nodes.find(function(el) {
      var txt = (el.textContent || '').replace(/\s+/g, ' ').trim();
      return txt === 'Fabriqué en France' || txt.startsWith('Fabriqué en France');
    });
    if (!label || label.dataset.sgfsFranceDone === '1') return;

    // Masquer le petit liseret/séparateur placé juste avant, si trouvé.
    var parent = label.parentElement;
    if (parent) {
      Array.from(parent.children).forEach(function(child) {
        if (child === label) return;
        var txt = (child.textContent || '').replace(/\s+/g, ' ').trim();
        var rect;
        try { rect = child.getBoundingClientRect(); } catch(e) { rect = {width: 0, height: 0}; }
        var isSmallVisual = txt === '' && rect.width <= 100 && rect.height <= 40;
        var className = (child.className || '').toString();
        var likelyStripe = /flag|stripe|liseret|separator|divider|icon/i.test(className);
        if (isSmallVisual || likelyStripe) {
          child.style.display = 'none';
        }
      });
    }

    label.classList.add('sgfs-france-title-patched');
    var flag = document.createElement('span');
    flag.className = 'sgfs-fr-flag';
    flag.setAttribute('aria-hidden', 'true');
    flag.innerHTML = '<span class="blue"></span><span class="white"></span><span class="red"></span>';

    label.insertBefore(flag, label.firstChild);
    label.dataset.sgfsFranceDone = '1';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', patchFranceBlock);
  } else {
    patchFranceBlock();
  }

  // sécurité si le bloc est hydraté après chargement
  setTimeout(patchFranceBlock, 500);
  setTimeout(patchFranceBlock, 1500);
})();
</script>

