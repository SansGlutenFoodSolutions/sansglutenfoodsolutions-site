<!-- SGFS_FRANCE_FLAG_FIX_V2 -->
<style>
.sgfs-france-real-flag {
  display:inline-block !important;
  font-size:22px !important;
  line-height:1 !important;
  width:auto !important;
  height:auto !important;
  margin-right:12px !important;
