}
</style>
<script>
(function () {
  function normalize(s) {
    return (s || '').replace(/\s+/g, ' ').trim();
  }

  function removeLikelyStripe(labelEl) {
    var parent = labelEl && labelEl.parentElement;
    if (!parent) return;

    var prev = labelEl.previousElementSibling;
    if (prev) {
      var t = normalize(prev.textContent);
      var r = prev.getBoundingClientRect();
      if (
        t === '' ||
        r.width <= 90 ||
        /flag|france|stripe|liseret|line|bar|divider|separator|icon/i.test((prev.className || '').toString())
      ) {
        prev.style.setProperty('display', 'none', 'important');
      }
    }

    Array.from(parent.children).forEach(function (el) {
      if (el === labelEl) return;
      var t = normalize(el.textContent);
      var r = el.getBoundingClientRect();
      var cls = (el.className || '').toString();
      var style = getComputedStyle(el);

      var smallEmptyVisual = t === '' && r.width <= 100 && r.height <= 35;
      var suspiciousClass = /stripe|liseret|divider|separator|france-flag|flag-line|tricolor/i.test(cls);
      var suspiciousGradient =
        (style.backgroundImage || '').includes('linear-gradient') &&
        r.width <= 120 && r.height <= 40;

      if (smallEmptyVisual || suspiciousClass || suspiciousGradient) {
        el.style.setProperty('display', 'none', 'important');
      }
    });
  }

  function patchFrance() {
    var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    var node;
    while ((node = walker.nextNode())) {
      var txt = normalize(node.nodeValue);
      if (txt === 'Fabriqué en France') {
        var label = node.parentElement;
        if (!label) continue;

        removeLikelyStripe(label);

        if (!label.querySelector('.sgfs-france-real-flag')) {
          var flag = document.createElement('span');
          flag.className = 'sgfs-france-real-flag';
          flag.setAttribute('aria-hidden', 'true');
          flag.textContent = '🇫🇷';
          label.insertBefore(flag, label.firstChild);
        }

        label.style.setProperty('display', 'inline-flex', 'important');
        label.style.setProperty('align-items', 'center', 'important');
        label.dataset.sgfsFranceFlagV2 = '1';
        return true;
      }
    }
    return false;
  }

  patchFrance();

  var obs = new MutationObserver(function () {
    patchFrance();
  });
  obs.observe(document.documentElement, { childList: true, subtree: true });

  setTimeout(patchFrance, 300);
  setTimeout(patchFrance, 1000);
  setTimeout(patchFrance, 2500);
})();
</script>
<!-- /SGFS_FRANCE_FLAG_FIX_V2 -->


